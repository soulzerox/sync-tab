{
  "manifest_version": 3,
  "name": "SyncTab — Group Sync",
  "version": "3.0.0",
  "description": "Sync เฉพาะแท็บใน tab group ที่มีชื่อแบบ real-time และเปิดกลับเป็น Sleeping Tabs ทั้งกลุ่มหรือบางส่วน (Edge/Chromium MV3, 100% local).",
  "key": "",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "unlimitedStorage"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "SyncTab Group Sync",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Open SyncTab Group Sync Popup"
    }
  }
}
